     /* Note that this is regular binary data, not escaped text representing the binary data: */
     if(buffer_binary && buffer_binary_length)
     {
+      //PDF : GdkPixbuf ne sait pas le lire. On rend la premiere page avec Poppler
+      //(deja dans le bundle), ce qui evite Evince et sa detection de type cassee
+      //sur macOS. Reconnu par sa signature %PDF.
+      const guchar* pdf_sig = static_cast<const guchar*>(buffer_binary);
+      if(buffer_binary_length >= 4 && pdf_sig[0] == '%' && pdf_sig[1] == 'P' &&
+         pdf_sig[2] == 'D' && pdf_sig[3] == 'F')
+      {
+        GBytes* pdf_bytes = g_bytes_new(buffer_binary, static_cast<gsize>(buffer_binary_length));
+        GError* pdf_error = nullptr;
+        PopplerDocument* pdf_doc = poppler_document_new_from_bytes(pdf_bytes, nullptr, &pdf_error);
+        if(pdf_doc)
+        {
+          PopplerPage* pdf_page = poppler_document_get_page(pdf_doc, 0);
+          if(pdf_page)
+          {
+            double pw = 0.0, ph = 0.0;
+            poppler_page_get_size(pdf_page, &pw, &ph);
+            const int iw = std::max(1, static_cast<int>(std::ceil(pw)));
+            const int ih = std::max(1, static_cast<int>(std::ceil(ph)));
+            cairo_surface_t* surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, iw, ih);
+            cairo_t* cr = cairo_create(surface);
+            cairo_set_source_rgb(cr, 1.0, 1.0, 1.0); //fond blanc
+            cairo_paint(cr);
+            poppler_page_render(pdf_page, cr);
+            cairo_destroy(cr);
+            cairo_surface_flush(surface);
+            result = Glib::wrap(gdk_pixbuf_get_from_surface(surface, 0, 0, iw, ih));
+            cairo_surface_destroy(surface);
+            g_object_unref(pdf_page);
+          }
+          g_object_unref(pdf_doc);
+        }
+        else if(pdf_error)
+        {
+          std::cerr << G_STRFUNC << ": Poppler: " << pdf_error->message << std::endl;
+          g_error_free(pdf_error);
+        }
+        g_bytes_unref(pdf_bytes);
+        return result;
+      }
