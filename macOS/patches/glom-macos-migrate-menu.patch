+void AppWindow::on_menu_file_migrate()
+{
+  Gtk::FileChooserDialog dialog(*this, _("Select the Glom Database to Migrate"));
+  dialog.set_transient_for(*this);
+  dialog.set_modal(true);
+  dialog.add_button(_("_Cancel"), Gtk::RESPONSE_CANCEL);
+  dialog.add_button(_("_Migrate"), Gtk::RESPONSE_OK);
+  dialog.set_default_response(Gtk::RESPONSE_OK);
+
+  auto filter = Gtk::FileFilter::create();
+  filter->add_mime_type("application/x-glom");
+  filter->add_pattern("*.glom");
+  filter->set_name(_("Glom files"));
+  dialog.add_filter(filter);
+
+  if(dialog.run() != Gtk::RESPONSE_OK)
+    return;
+  const std::string glom_path = dialog.get_filename();
+  dialog.hide();
+  if(glom_path.empty())
+    return;
+
+  const bool at_welcome = (get_document() && get_document()->get_is_new());
+
+  const std::string base_dir = Glib::path_get_dirname(glom_path);
+  const std::string version_file =
+    Glib::build_filename(base_dir, "glom_postgres_data", "data", "PG_VERSION");
+
+  if(!Glib::file_test(version_file, Glib::FILE_TEST_EXISTS))
+  {
+    Gtk::MessageDialog d(*this,
+      _("This Glom file has no self-hosted PostgreSQL database beside it, so there is nothing to migrate."),
+      false, Gtk::MESSAGE_WARNING, Gtk::BUTTONS_OK, true);
+    d.set_title(_("Not a Self-Hosted Database"));
+    d.run();
+    return;
+  }
+
+  std::string cluster_version;
+  try
+  {
+    cluster_version = Glib::file_get_contents(version_file);
+  }
+  catch(const Glib::Error& ex)
+  {
+    Gtk::MessageDialog d(*this, ex.what(),
+      false, Gtk::MESSAGE_ERROR, Gtk::BUTTONS_OK, true);
+    d.set_title(_("Cannot Read Database Version"));
+    d.run();
+    return;
+  }
+  while(!cluster_version.empty() &&
+    (cluster_version.back() == '\n' || cluster_version.back() == '\r' ||
+     cluster_version.back() == ' '  || cluster_version.back() == '\t'))
+    cluster_version.pop_back();
+
+  if(cluster_version == "18")
+  {
+    if(at_welcome)
+    {
+      Gtk::MessageDialog d(*this,
+        _("This database already uses PostgreSQL 18."),
+        false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_OK, true);
+      d.set_title(_("Already PostgreSQL 18"));
+      d.run();
+    }
+    else
+    {
+      Gtk::MessageDialog d(*this,
+        _("This database already uses PostgreSQL 18. Do you want to open it?"),
+        false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_NONE, true);
+      d.set_title(_("Already PostgreSQL 18"));
+      d.add_button(_("_Close"), Gtk::RESPONSE_CANCEL);
+      d.add_button(_("_Open"),  Gtk::RESPONSE_ACCEPT);
+      d.set_default_response(Gtk::RESPONSE_ACCEPT);
+      if(d.run() == Gtk::RESPONSE_ACCEPT)
+        open_document(Glib::filename_to_uri(glom_path));
+    }
+    return;
+  }
+
+  {
+    Gtk::MessageDialog d(*this,
+      Glib::ustring::compose(
+        _("The database \"%1\" currently uses PostgreSQL %2.\n\nIt will be migrated to PostgreSQL 18. A backup of the old database is kept beside it, and the database is not changed until the migration succeeds.\n\nMigrate now?"),
+        Glib::path_get_basename(base_dir), cluster_version),
+      false, Gtk::MESSAGE_QUESTION, Gtk::BUTTONS_NONE, true);
+    d.set_title(_("Migrate to PostgreSQL 18"));
+    d.add_button(_("_Cancel"),  Gtk::RESPONSE_CANCEL);
+    d.add_button(_("_Migrate"), Gtk::RESPONSE_ACCEPT);
+    d.set_default_response(Gtk::RESPONSE_ACCEPT);
+    if(d.run() != Gtk::RESPONSE_ACCEPT)
+      return;
+  }
+
+#if defined(POSTGRES_UTILS_PATH) && !defined(G_OS_WIN32)
+  const std::string pg_bin = POSTGRES_UTILS_PATH;
+#else
+  const std::string pg_bin;
+#endif
+  const std::string script = Glib::build_filename(pg_bin, "glom-pg-migrate.sh");
+  if(pg_bin.empty() || !Glib::file_test(script, Glib::FILE_TEST_EXISTS))
+  {
+    Gtk::MessageDialog d(*this,
+      Glib::ustring::compose(_("The migration tool was not found:\n%1"), script),
+      false, Gtk::MESSAGE_ERROR, Gtk::BUTTONS_OK, true);
+    d.set_title(_("Migration Tool Not Found"));
+    d.run();
+    return;
+  }
+
+  auto sq = [](const std::string& s) -> std::string
+  {
+    char* q = g_shell_quote(s.c_str());
+    const std::string r = q ? q : std::string();
+    g_free(q);
+    return r;
+  };
+
+  const std::string command =
+    "/bin/bash " + sq(script) +
+    " --run --new-bindir=" + sq(pg_bin) +
+    " " + sq(base_dir);
+
+  const Glom::Spawn::SlotProgress slot_progress = []()
+  {
+    auto context = Glib::MainContext::get_default();
+    while(context->pending())
+      context->iteration(false);
+  };
+
+  std::string output;
+  const bool ok =
+    Glom::Spawn::execute_command_line_and_wait(command, slot_progress, output);
+
+  if(ok)
+  {
+    if(at_welcome)
+    {
+      Gtk::MessageDialog d(*this,
+        _("The database was migrated to PostgreSQL 18. You can open it now."),
+        false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_OK, true);
+      d.set_title(_("Migration Complete"));
+      d.run();
+    }
+    else
+    {
+      Gtk::MessageDialog d(*this,
+        _("The database was migrated to PostgreSQL 18. Open it now?"),
+        false, Gtk::MESSAGE_INFO, Gtk::BUTTONS_NONE, true);
+      d.set_title(_("Migration Complete"));
+      d.add_button(_("_Close"), Gtk::RESPONSE_CANCEL);
+      d.add_button(_("_Open"),  Gtk::RESPONSE_ACCEPT);
+      d.set_default_response(Gtk::RESPONSE_ACCEPT);
+      if(d.run() == Gtk::RESPONSE_ACCEPT)
+        open_document(Glib::filename_to_uri(glom_path));
+    }
+  }
+  else
+  {
+    Gtk::MessageDialog d(*this,
+      _("The migration did not complete. The database was not changed."),
+      false, Gtk::MESSAGE_ERROR, Gtk::BUTTONS_OK, true);
+    d.set_title(_("Migration Failed"));
+    if(!output.empty())
+      d.set_secondary_text(output);
+    d.run();
+  }
+}
